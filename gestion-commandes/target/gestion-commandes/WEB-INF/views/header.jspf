<%@ taglib prefix="c" uri="http://java.sun.com/jsp/jstl/core" %>
<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><c:out value="${pageTitle}"/> · Commande Studio</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Manrope:wght@500;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="<c:url value='/css/style.css'/>">
</head>
<body>
<div class="app-shell">
  <aside class="sidebar" id="sidebar">
    <a class="brand" href="<c:url value='/'/>">
      <span class="brand-mark">CS</span>
      <span class="brand-copy"><strong>Commande</strong><small>STUDIO · GESTION</small></span>
    </a>
    <div class="nav-label">ESPACE DE TRAVAIL</div>
    <nav class="side-nav" aria-label="Navigation principale">
      <a class="${pageTitle == 'Accueil' ? 'active' : ''}" href="<c:url value='/'/>"><span class="nav-icon">◫</span><span>Vue d'ensemble</span></a>
      <a class="${pageTitle == 'Clients' || pageTitle == 'Client' ? 'active' : ''}" href="<c:url value='/clients'/>"><span class="nav-icon">♙</span><span>Clients</span></a>
      <a class="${pageTitle == 'Produits' || pageTitle == 'Produit' ? 'active' : ''}" href="<c:url value='/produits'/>"><span class="nav-icon">▦</span><span>Produits & stock</span></a>
      <a class="${pageTitle == 'Commandes' || pageTitle == 'Commande' || pageTitle == 'Détail commande' ? 'active' : ''}" href="<c:url value='/commandes'/>"><span class="nav-icon">↗</span><span>Commandes</span></a>
    </nav>
    <div class="sidebar-bottom">
      <div class="sidebar-note"><span class="note-icon">✦</span><div><strong>Votre espace de gestion</strong><p>Clients, catalogue et commandes réunis au même endroit.</p></div></div>
      <div class="sidebar-foot"><span class="status-dot"></span> Espace opérationnel <span class="version">v1.0</span></div>
    </div>
  </aside>
  <section class="workspace">
    <header class="topbar">
      <div class="topbar-left">
        <button type="button" class="icon-button mobile-menu" aria-label="Afficher la navigation" onclick="document.getElementById('sidebar').classList.toggle('sidebar-open')">☰</button>
        <div class="breadcrumbs"><span>Workspace</span><span class="crumb-sep">/</span><strong><c:out value="${pageTitle}"/></strong></div>
      </div>
      <div class="topbar-right"><span class="topbar-date">Gestion commerciale</span><span class="avatar">CS</span></div>
    </header>
    <main class="main-content">
